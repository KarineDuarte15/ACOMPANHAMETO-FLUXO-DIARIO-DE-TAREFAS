rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to get user profile from db
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper to check if user is admin
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'ADMIN';
    }
    
    // Helper to check if user is active
    function isActive() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().ativo == true;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      // Permite criar o próprio registro inicial, ou se o criador for um administrador
      allow create: if isAuthenticated() && (userId == request.auth.uid || isAdmin());
      // Apenas administradores podem atualizar perfis e roles de outros usuários
      allow update, delete: if isAdmin();
    }

    match /appState/{docId} {
      allow read: if isAuthenticated() && isActive();
      allow write: if isAuthenticated() && isActive() && (isAdmin() || docId == 'state_' + request.auth.uid);
    }
    
    match /teamSettings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      // Qualquer usuário ativo pode registrar auditorias
      allow create: if isAuthenticated() && isActive();
      allow update, delete: if false; // Logs são imutáveis e append-only
    }
  }
}
